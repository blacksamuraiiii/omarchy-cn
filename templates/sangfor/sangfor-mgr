#!/bin/bash
# ==============================================================================
# sangfor-mgr: 深信服服务与进程统一生命周期管理脚本
# 支持 aTrust 与 EasyConnect 的无缝加锁、解锁、启停与孤儿进程彻底清理
# 包含调用链路追踪（Trace ID）与结构化可观测性日志
# ==============================================================================

set -o pipefail

# 产生唯一调用链追踪 ID (8位十六进制)
TRACE_ID=$(cat /proc/sys/kernel/random/uuid 2>/dev/null | cut -c1-8 || tr -dc 'a-f0-9' < /dev/urandom | head -c 8)
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

log_info() {
    echo "[${TIMESTAMP}][${TRACE_ID}][INFO] $1"
}

log_warn() {
    echo "[${TIMESTAMP}][${TRACE_ID}][WARN] $1"
}

log_error() {
    echo "[${TIMESTAMP}][${TRACE_ID}][ERROR] $1"
}

case "$1" in
    start-atrust)
        log_info "执行 aTrust 解锁与服务拉起..."
        systemctl unmask aTrustDaemon.service 2>/dev/null || true
        systemctl start aTrustDaemon.service 2>/dev/null || true
        log_info "aTrustDaemon 服务已启动并保持活跃。"
        ;;

    stop-atrust)
        log_info "执行 aTrust 服务停用、全系统 Mask 锁定与残留进程清理..."
        systemctl stop aTrustDaemon.service 2>/dev/null || true
        systemctl mask aTrustDaemon.service 2>/dev/null || true
        killall -9 aTrustAgent aTrustXtunnel-64 2>/dev/null || true
        log_info "aTrust 服务已安全锁定，无任何后台残留。"
        ;;

    start-easyconnect)
        log_info "执行 EasyConnect 监控服务解锁、开机自启保障与服务拉起..."
        systemctl unmask EasyMonitor.service 2>/dev/null || true
        systemctl enable EasyMonitor.service 2>/dev/null || true
        systemctl start EasyMonitor.service 2>/dev/null || true

        # 校验并自动固化 svpnservice DNS 防劫持补丁 (防 pacman 升级或系统重置后复发)
        SVPN_BIN="/usr/share/sangfor/EasyConnect/resources/bin/svpnservice"
        if [ -f "$SVPN_BIN" ] && strings "$SVPN_BIN" 2>/dev/null | grep -q "/etc/resolv.conf"; then
            log_warn "检测到 svpnservice 存在 DNS 劫持风险，自动执行热补丁重定向至 /tmp/resolv.conf..."
            [ ! -f "${SVPN_BIN}.orig" ] && cp -p "$SVPN_BIN" "${SVPN_BIN}.orig"
            sed -i 's|/etc/resolv\.conf|/tmp/resolv.conf|g' "$SVPN_BIN"
        fi

        # 检查宿主机 /etc/resolv.conf 是否遗留深信服 127.0.0.1 坏死配置，若有则自愈
        if [ -f /etc/resolv.conf ] && grep -q ";sangfor-dns-client" /etc/resolv.conf 2>/dev/null; then
            log_warn "检测到 /etc/resolv.conf 残留 sangfor-dns-client 坏死配置，触发系统 DNS 自动自愈..."
            if [ -e /run/systemd/resolve/stub-resolv.conf ]; then
                ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
            elif [ -e /etc/resolv.conf.sangforbak ]; then
                cp -f /etc/resolv.conf.sangforbak /etc/resolv.conf
            fi
        fi

        log_info "EasyMonitor 服务已启动并保持开机自启，DNS 防冲突屏障已激活。"
        ;;

    stop-easyconnect)
        log_info "执行 EasyConnect 隧道中断、监控服务停止与残留进程深度清理..."
        systemctl stop EasyMonitor.service 2>/dev/null || true
        # 注意：此处切勿执行 systemctl mask，否则会导致下次开机或重启后服务无法自启，前端报 Local environment contains error
        killall -9 EasyConnect EasyMonitor ECAgent CSClient svpnservice 2>/dev/null || true

        # 退出自愈保护：确保退出后宿主机 resolv.conf 无残留
        if [ -f /etc/resolv.conf ] && grep -q ";sangfor-dns-client" /etc/resolv.conf 2>/dev/null; then
            log_warn "清理残留的 sangfor-dns-client 配置，恢复原生系统解析器..."
            if [ -e /run/systemd/resolve/stub-resolv.conf ]; then
                ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
            elif [ -e /etc/resolv.conf.sangforbak ]; then
                cp -f /etc/resolv.conf.sangforbak /etc/resolv.conf
            fi
        fi

        log_info "EasyConnect 及其底层隧道（CSClient/svpnservice/ECAgent）已完全断开并清理。"
        ;;

    status)
        log_info "=== 深信服服务与进程状态检测 ==="
        echo "aTrustDaemon.service 状态: $(systemctl is-active aTrustDaemon.service 2>/dev/null || echo 'unknown') (is-enabled: $(systemctl is-enabled aTrustDaemon.service 2>/dev/null || echo 'unknown'))"
        echo "EasyMonitor.service 状态: $(systemctl is-active EasyMonitor.service 2>/dev/null || echo 'unknown') (is-enabled: $(systemctl is-enabled EasyMonitor.service 2>/dev/null || echo 'unknown'))"
        echo "运行中进程清单:"
        ps aux | grep -E "aTrust|sangfor|EasyConnect|EasyMonitor|ECAgent|CSClient|svpnservice" | grep -v grep || echo "（无存活进程）"
        ;;

    *)
        echo "用法: $0 {start-atrust|stop-atrust|start-easyconnect|stop-easyconnect|status}"
        exit 1
        ;;
esac
